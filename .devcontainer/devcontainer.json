{
	"name": "acolite-mp-dev",
  // "build": { "dockerfile": "Dockerfile" },
	// "image": "444488357543.dkr.ecr.ap-southeast-2.amazonaws.com/easi-workflows-base:test",
	"dockerComposeFile": ["../docker-compose.yaml", "docker-compose.extend.yaml"],
	"service": "acolite-mp-dev",
	"shutdownAction": "stopCompose",
	"workspaceFolder": "/home/vscode/acolite-mp",
	"remoteUser": "vscode",
  "mounts": [
		"source=${localWorkspaceFolder}/../acolite-mp-fixtures,target=/home/vscode/acolite-mp-fixtures,type=bind,consistency=cached"
	],
"customizations": {
	"vscode": {
		"extensions": [
			"moshfeu.compare-folders",
			"twxs.cmake",
			"mhutchie.git-graph",
			"ms-python.isort",
			"ephoton.indent-switcher",
			"oderwat.indent-rainbow",
			"ms-python.python",
			"ms-python.vscode-pylance",
			"Gruntfuggly.todo-tree",
			"ms-toolsai.jupyter",
			"svipas.prettier-plus",
			"ms-python.black-formatter",
			"amazonwebservices.aws-toolkit-vscode",
			"github.copilot",
			"emeryberger.scalene",
			"ritwickdey.liveserver"
		]
	}
}
